<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConkerLauncher.ViewModels"
        xmlns:v="using:ConkerLauncher.Views"
        x:Class="ConkerLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Conker: Live &amp; Recompiled"
        Icon="/Assets/launcher.ico"
        Width="760" Height="700" MinWidth="760" MinHeight="700"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        Background="#FF0A0E0A">
  <Window.Resources>
    <!-- A running import or download, and the last one's result; shown in the section it belongs to. -->
    <DataTemplate x:Key="JobProgress" x:DataType="vm:FilesViewModel">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource DimTextBrush}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                       IsIndeterminate="{Binding ProgressIndeterminate}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="JobStatus" x:DataType="vm:FilesViewModel">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                 Classes.error="{Binding StatusIsError}" Classes.ok="{Binding !StatusIsError}" />
    </DataTemplate>
  </Window.Resources>
  <!-- The rows of the Settings and Controls tabs (the F2 and F3 menus' entries). -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:SectionItem">
      <TextBlock Classes="section" Text="{Binding Label}" Margin="0,14,0,4" />
    </DataTemplate>
    <DataTemplate DataType="vm:LineItem">
      <Border Height="1" Background="{StaticResource DimTextBrush}" Opacity="0.5" Margin="0,12,0,6" />
    </DataTemplate>
    <DataTemplate DataType="vm:NoteItem">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,4" />
    </DataTemplate>
    <!-- Quality presets (to-do 202): a drop-down at the top of Graphics, as in F2. -->
    <DataTemplate DataType="vm:PresetItem">
      <Border Classes="row">
      <StackPanel Spacing="4" Margin="0,4" ToolTip.Tip="{Binding Tip}" Background="Transparent">
        <TextBlock Text="{Binding Label}" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Label}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PresetOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:CheckItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsAvailable}"
                  ToolTip.Tip="{Binding Tip}" Margin="{Binding Indent}" />
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:ChoiceItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
      <StackPanel Spacing="4" Margin="0,4" ToolTip.Tip="{Binding Tip}" Background="Transparent">
        <TextBlock Text="{Binding Label}" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Label}"
                  HorizontalAlignment="Stretch" IsEnabled="{Binding IsAvailable}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:SliderItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
      <StackPanel Spacing="0" Margin="{Binding SliderIndent}" ToolTip.Tip="{Binding Tip}" Background="Transparent"
                  Grid.IsSharedSizeScope="True">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          <!-- A sound channel's Mute (to-do 13; user 2026-11-07): the word over the value, the box over the reset button. -->
          <TextBlock Grid.Column="1" Text="Mute" IsVisible="{Binding HasMute}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <CheckBox Classes="box" Grid.Column="2" IsChecked="{Binding IsMuted}" IsVisible="{Binding HasMute}" HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding MuteName}" MinWidth="0" MinHeight="0" Padding="0" />
        </Grid>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
          </Grid.ColumnDefinitions>
          <Slider AutomationProperties.Name="{Binding Label}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                  TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                  SmallChange="{Binding Step}" IsEnabled="{Binding IsAvailable}" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <Button Grid.Column="2" Content="↺" Command="{Binding ResetValueCommand}" ToolTip.Tip="{Binding ResetTip}"
                  AutomationProperties.Name="{Binding ResetTip}"
                  VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:RadioItem">
      <Border Classes="row">
      <ItemsControl ItemsSource="{Binding Options}" Margin="0,2">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RadioOption">
            <RadioButton Content="{Binding Name}" GroupName="{Binding Group}" IsChecked="{Binding IsChecked}" Margin="0,1" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </DataTemplate>
    <!-- A key row: the action (and the controller button it presses), its key, a reset icon when changed. -->
    <DataTemplate DataType="vm:KeyItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
      <Grid ColumnDefinitions="*,160,36" ColumnSpacing="6" Margin="0,1">
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,6,0" />
          <TextBlock Text="{Binding ButtonText}" Foreground="{StaticResource DimTextBrush}"
                     IsVisible="{Binding ButtonText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </WrapPanel>
        <Button Grid.Column="1" Content="{Binding KeyLabel}" Command="{Binding CaptureCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding AutomationName}"
                Classes.clash="{Binding IsClash}" ToolTip.Tip="{Binding ClashTip}" />
        <Button Grid.Column="2" Content="↺" Command="{Binding ResetKeyCommand}" IsVisible="{Binding IsChanged}"
                ToolTip.Tip="{Binding ResetTip}" AutomationProperties.Name="{Binding ResetTip}" VerticalAlignment="Center" />
      </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:FixedItem">
      <Grid ColumnDefinitions="200,*" ColumnSpacing="8" Margin="0,2">
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding Keys}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ResetItem">
      <StackPanel Margin="0,10,0,4" Spacing="6">
        <Button Content="{Binding Label}" Command="{Binding AskCommand}" IsVisible="{Binding !IsAsking}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAsking}">
          <TextBlock Text="{Binding Question}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          <Button Content="Yes" Command="{Binding ConfirmCommand}" />
          <Button Classes="safe" Content="No" Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:SlotsItem">
      <StackPanel Spacing="4" Margin="0,6">
        <Grid ColumnDefinitions="70,*,90" ColumnSpacing="8">
          <TextBlock Text="Slot" Foreground="{StaticResource DimTextBrush}" />
          <TextBlock Grid.Column="1" Text="Controller" Foreground="{StaticResource DimTextBrush}" />
          <TextBlock Grid.Column="2" Text="Keyboard" Foreground="{StaticResource DimTextBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SlotRow">
              <Border Classes="row">
              <Grid ColumnDefinitions="70,*,90" ColumnSpacing="8" Margin="0,2">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                          AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoiceOption">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Classes="box" Grid.Column="2" IsChecked="{Binding KeyboardOn}" ToolTip.Tip="{Binding KeyboardTip}"
                          AutomationProperties.Name="{Binding KeyboardName}" HorizontalAlignment="Center" />
              </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Look for controllers again" Margin="0,4,0,0"
                Command="{Binding $parent[TabControl].((vm:ControlsViewModel)DataContext).RefreshPadsCommand}" />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>
  <Panel>
    <!-- A soft green glow behind the logo, like the original Xbox dashboard. -->
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="80%" RadiusY="60%">
          <GradientStop Color="#55107C10" Offset="0" />
          <GradientStop Color="#00107C10" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <!-- The page (Page): while a pop-up shows, keyboard Tab skips it (MainWindow.UpdateOverlayFocus). -->
    <DockPanel x:Name="Page" Margin="24,0,24,20">
      <!-- The logo; dragging it moves the window, like a title bar. -->
      <Border DockPanel.Dock="Top" Background="Transparent" Padding="0,16,0,8"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Image Source="/Assets/logo.png" Height="150" HorizontalAlignment="Center" />
      </Border>

      <!-- Room for the button hints (drawn last, over the pop-ups' dimming) while the pad is in use. -->
      <Border DockPanel.Dock="Bottom" Height="26" IsVisible="{Binding PadMode}" />

      <!-- Version History, Auto Update, Update and Play (SPEC 9.3) -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,16,0,0">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding Message}" Foreground="#FFE0A040" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding VersionLine}" Foreground="{StaticResource DimTextBrush}" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Button Content="Version History" Command="{Binding OpenHistoryCommand}" FontSize="12" Padding="10,3" />
            <CheckBox Content="Auto Update" IsChecked="{Binding AutoUpdate}" FontSize="12" MinHeight="24"
                      ToolTip.Tip="Install a new version by itself whenever the launcher starts" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Content="{Binding UpdateButtonText}" Command="{Binding OpenUpdatePromptCommand}" />
        <Button Grid.Column="2" Classes="play" Content="PLAY" Command="{Binding PlayCommand}" />
      </Grid>

      <!-- Help line while the pad is in use (to-do 121 1f): the focused control's tooltip, which a
           pad can't hover; up to four lines (about 3 in 4 texts whole; user 2026-11-07), kept
           free so the page doesn't jump. -->
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding HelpText}" IsVisible="{Binding PadMode}"
                 FontSize="12" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap"
                 MaxLines="4" TextTrimming="CharacterEllipsis" Height="66" Margin="8,8,8,0" />

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="12,4,12,12">
        <TabControl x:Name="MainTabs">
          <TabItem Header="FILES">
            <ScrollViewer DataContext="{Binding Files}" x:DataType="vm:FilesViewModel">
              <StackPanel Spacing="10" Margin="4,8,16,4">
                <!-- Game files -->
                <TextBlock Classes="section" Text="Game files" />
                <TextBlock Text="{Binding GameFilesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding ImportButtonText}" Command="{Binding ImportGameCommand}" />
                </StackPanel>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobProgress}" IsVisible="{Binding GameJobVisible}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobStatus}" IsVisible="{Binding GameStatusVisible}" />

                <!-- Decensor patch -->
                <TextBlock Classes="section" Text="Decensor patch" Margin="0,8,0,0" />
                <TextBlock Text="{Binding DecensorText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding AddPatchButtonText}" Command="{Binding AddPatchCommand}" />
                  <Button Content="{Binding DownloadButtonText}" Command="{Binding DownloadPatchCommand}" />
                </StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobProgress}" IsVisible="{Binding DecensorJobVisible}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobStatus}" IsVisible="{Binding DecensorStatusVisible}" />
                <TextBlock Text="{Binding DecensorCheckNote}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                           IsVisible="{Binding DecensorCheckNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                           Text="The decensor patch is made by nastys, Vaani and Theconker64 and is downloaded from their GitHub releases. It is not part of this launcher." />

                <!-- Shaders: conker.exe precompile-shaders fills the shader cache (to-do 25, SPEC 9.3). -->
                <TextBlock Classes="section" Text="Shaders" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ShadersText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ConfirmDeleteShaders}">
                  <Button Content="{Binding PrecompileButtonText}" Command="{Binding PrecompileShadersCommand}" />
                  <Button Content="Delete Shaders" Command="{Binding AskDeleteShadersCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmDeleteShaders}">
                  <TextBlock Text="Delete every compiled shader? The game compiles them again as you play (or precompile again)."
                             TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="480" />
                  <Button Content="Yes" Command="{Binding DeleteShadersCommand}" />
                  <Button Classes="safe" Content="No" Command="{Binding CancelDeleteShadersCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding PrecompileError}" TextWrapping="Wrap" Classes="error"
                           IsVisible="{Binding PrecompileError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- User files: where they are kept (SPEC 9.3); a change moves them. -->
                <TextBlock Classes="section" Text="User files" Margin="0,8,0,0" />
                <StackPanel Spacing="4" DataContext="{Binding UserFiles}" x:DataType="vm:UserFilesViewModel">
                  <TextBlock Text="Saves, settings, photos and logs are kept in:" TextWrapping="Wrap" />
                  <RadioButton GroupName="UserFiles" Content="The game folder (userdata)" IsChecked="{Binding InGameFolder}"
                               IsEnabled="{Binding CanChoose}" />
                  <RadioButton GroupName="UserFiles" Content="{Binding AppDataText}" IsChecked="{Binding InAppData}"
                               IsEnabled="{Binding CanChoose}" />
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                             IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                             Classes.error="{Binding StatusIsError}" Classes.ok="{Binding !StatusIsError}"
                             IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Logs" Command="{Binding OpenLogsCommand}" />
                  <Button Content="Saves" Command="{Binding OpenSavesCommand}" />
                  <Button Content="Photos" Command="{Binding OpenPhotosCommand}" />
                  <Button Content="Report Bug" Command="{Binding Report.OpenCommand}"
                          ToolTip.Tip="Makes a .zip to attach to a GitHub issue, for a crash noticed later" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="SETTINGS">
            <!-- The game's F2 menu, from what conker.exe dump-settings prints (SPEC 9.3). -->
            <DockPanel DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="4,8,16,4">
                <TextBlock Text="The game is running: change settings in its F2 menu. This tab unlocks when the game closes."
                           TextWrapping="Wrap" Foreground="#FFE0A040" IsVisible="{Binding IsLocked}" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Classes="error"
                           IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ConfirmReset}">
                  <Button Content="Reset to defaults" Command="{Binding AskResetCommand}" IsEnabled="{Binding IsEditable}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmReset}">
                  <TextBlock Text="Set every setting (all four tabs, not the controls) back to the default?"
                             TextWrapping="Wrap" VerticalAlignment="Center" />
                  <Button Content="Reset" Command="{Binding ResetCommand}" />
                  <Button Classes="safe" Content="Cancel" Command="{Binding CancelResetCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding TopItems}" IsEnabled="{Binding IsEditable}" />
              </StackPanel>
              <!-- F2's tabs (to-do 11). -->
              <TabControl Classes="inner" ItemsSource="{Binding Tabs}" IsEnabled="{Binding IsEditable}">
                <TabControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <ScrollViewer Offset="{Binding ScrollOffset, Mode=OneWay}">
                      <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,16,4" />
                    </ScrollViewer>
                  </DataTemplate>
                </TabControl.ContentTemplate>
              </TabControl>
            </DockPanel>
          </TabItem>
          <TabItem Header="CONTROLS">
            <!-- The game's F3 menu, from what conker.exe dump-settings and list-pads print (SPEC 9.3). -->
            <DockPanel DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="4,8,16,0">
                <TextBlock Text="The game is running: change controls in its F3 menu. This tab unlocks when the game closes."
                           TextWrapping="Wrap" Foreground="#FFE0A040" IsVisible="{Binding IsLocked}" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Classes="error"
                           IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl ItemsSource="{Binding TopItems}" IsEnabled="{Binding IsEditable}" />
              </StackPanel>
              <TabControl Classes="inner" ItemsSource="{Binding Tabs}" IsEnabled="{Binding IsEditable}">
                <TabControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <ScrollViewer Offset="{Binding ScrollOffset, Mode=OneWay}">
                      <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,16,4" />
                    </ScrollViewer>
                  </DataTemplate>
                </TabControl.ContentTemplate>
              </TabControl>
            </DockPanel>
          </TabItem>
          <TabItem Header="DEBUG">
            <!-- To-do 144 (SPEC 9.3): Debug Mode for Play, and the save editor (to-do 147, conker.exe edit-save). -->
            <ScrollViewer DataContext="{Binding Debug}" x:DataType="vm:DebugViewModel">
              <StackPanel Spacing="10" Margin="4,8,16,4">
                <TextBlock Classes="section" Text="Debug mode" />
                <Border Classes="row">
                  <CheckBox Content="Debug Mode" IsChecked="{Binding DebugMode}"
                            ToolTip.Tip="Play starts the game with --debug: the console (~), the Debug menu (F8), debug choices in F2, the frame rate in the title bar. Remembered" />
                </Border>
                <TextBlock Text="Play starts the game with the console, the Debug menu and its tools. Remembered for the next start."
                           TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" FontSize="12" />

                <TextBlock Classes="section" Text="Edit Save" Margin="0,8,0,0" />
                <TextBlock Text="Moves a save to the start of a chapter's part, as the Chapters list starts it; loading it then starts there. A copy of the save goes to edit_save_backups in the save folder first."
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                  <TextBlock Text="Game" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                            AutomationProperties.Name="Game" HorizontalAlignment="Stretch" ToolTip.Tip="The save to change">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GameChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="Chapter" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}"
                            AutomationProperties.Name="Chapter" HorizontalAlignment="Stretch" ToolTip.Tip="The chapter, as the Chapters list has them">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChapterChoice">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="2" Text="Part" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SelectedChapter.Parts}" SelectedItem="{Binding SelectedPart}"
                            AutomationProperties.Name="Part" HorizontalAlignment="Stretch" ToolTip.Tip="Where the save starts">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PartChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Button Content="Edit Save" Command="{Binding AskEditCommand}" IsVisible="{Binding !IsAsking}"
                        ToolTip.Tip="Asks first; not while the game runs" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAsking}">
                  <TextBlock Text="{Binding Question}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                  <Button Content="Yes" Command="{Binding ConfirmEditCommand}" />
                  <Button Classes="safe" Content="No" Command="{Binding CancelEditCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           Classes.error="{Binding StatusIsError}" Classes.ok="{Binding !StatusIsError}"
                           IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </DockPanel>

    <!-- First launch: offer the import (SPEC 9.3); it can be closed, Play stays off. -->
    <!-- Not over the user files pop-ups: those come first. -->
    <Panel IsVisible="{Binding !UserFiles.IsBusy}">
    <Border x:Name="WelcomeOverlay" Background="#B0000000" IsVisible="{Binding ShowImportPrompt}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="Welcome" FontSize="22" />
          <TextBlock TextWrapping="Wrap"
                     Text="To play, the launcher needs the game files from your own Conker: Live &amp; Reloaded disc (PAL or USA): a disc image (.iso), an archive holding it (.zip, .7z, .rar), or a copied game folder." />
          <!-- A file dropped here is imported at once (to-do 122); a drag it won't take says why while it hovers. -->
          <Panel>
            <TextBlock Text="or drag your disc image here" FontSize="13" Foreground="{StaticResource DimTextBrush}"
                       IsVisible="{Binding WelcomeDropProblem, Converter={x:Static ObjectConverters.IsNull}}" />
            <TextBlock Classes="error" Text="{Binding WelcomeDropProblem}" FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding WelcomeDropProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Panel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="secondary safe" Content="Not now" Command="{Binding DismissImportPromptCommand}" />
            <Button Classes="play" Content="Import Files" FontSize="16" Command="{Binding ImportFromPromptCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    </Panel>

    <!-- A new release (SPEC 9.3): its page text, Update Now / Update Later, Don't remind me. -->
    <Panel IsVisible="{Binding !UserFiles.IsBusy}">
    <Border x:Name="UpdateOverlay" Background="#B0000000" IsVisible="{Binding ShowUpdatePrompt}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="Update available" FontSize="22" />
          <TextBlock Text="{Binding UpdateTitle}" Foreground="{StaticResource DimTextBrush}" />
          <Border Background="#FF0A0E0A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer MaxHeight="340">
              <v:ReleaseNotesView Markdown="{Binding NewRelease.Body, FallbackValue=''}" Margin="14,10,18,12" />
            </ScrollViewer>
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <CheckBox Content="Don't remind me" IsChecked="{Binding SkipThisRelease}" VerticalAlignment="Center"
                      ToolTip.Tip="No window at start for this version; it shows again when a newer one is out" />
            <Button Grid.Column="1" Classes="secondary safe" Content="Update Later" Command="{Binding UpdateLaterCommand}" />
            <Button Grid.Column="2" Classes="play" Content="Update Now" FontSize="16" Command="{Binding UpdateCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Version History: every release's page text, newest first. -->
    <Border x:Name="HistoryOverlay" Background="#B0000000" IsVisible="{Binding ShowHistory}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="640" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="Version history" FontSize="22" Margin="0,0,0,12" />
          <Button DockPanel.Dock="Bottom" Classes="secondary safe" Content="Close" Command="{Binding CloseHistoryCommand}"
                  HorizontalAlignment="Right" Margin="0,12,0,0" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryNote}" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}"
                     IsVisible="{Binding HistoryNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Border Background="#FF0A0E0A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                  IsVisible="{Binding History, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding History}" Margin="14,4,18,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntry">
                    <StackPanel Spacing="4" Margin="0,10,0,8">
                      <WrapPanel>
                        <TextBlock Classes="section" Text="{Binding Title}" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding DateLine}" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" />
                      </WrapPanel>
                      <v:ReleaseNotesView Markdown="{Binding Body}" />
                      <HyperlinkButton Content="Open on GitHub" NavigateUri="{Binding Page}" Padding="0,2"
                                       IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Border>
    </Panel>

    <!-- Report Bug (to-do 12d, SPEC 9.2): the Files tab's button; the zip is conker.exe's own. -->
    <Border x:Name="ReportOverlay" Background="#B0000000" DataContext="{Binding Files.Report}" x:DataType="vm:ReportBugViewModel"
            IsVisible="{Binding IsOpen}">
      <Border x:Name="ReportPanel" Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Focusable="True" FocusAdorner="{x:Null}">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="Report Bug" FontSize="22" />
          <StackPanel Spacing="10" IsVisible="{Binding IsEdit}">
            <TextBlock Text="What went wrong, and what were you doing? (optional)" TextWrapping="Wrap" />
            <TextBox x:Name="ReportText" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" />
            <CheckBox Content="Include save files" IsChecked="{Binding IncludeSaves}" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                       Text="Makes a .zip to attach to a GitHub issue: the game's last logs, its settings, the saves when ticked and the PC's details (Windows, graphics card, processor). The Windows user name is left out." />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="secondary safe" Content="Cancel" Command="{Binding CloseCommand}" />
              <Button x:Name="ReportCreate" Classes="play" Content="Create Report" FontSize="16" Command="{Binding CreateCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="10" IsVisible="{Binding IsWorking}">
            <TextBlock Text="Creating the report..." Foreground="{StaticResource DimTextBrush}" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
          <StackPanel Spacing="10" IsVisible="{Binding IsDone}">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                       Text="Open GitHub Issue opens a new issue with its text filled in and copies that text too: if the page comes up empty, paste it there (Ctrl+V). Then drag the zip into the issue. Posting needs a free GitHub account." />
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                       IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" />
              <Button x:Name="ReportIssue" Content="Open GitHub Issue" Command="{Binding OpenIssueCommand}" />
              <Button Classes="secondary safe" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="10" IsVisible="{Binding IsFailed}">
            <TextBlock Classes="error" Text="{Binding ResultText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button x:Name="ReportBack" Content="Back" Command="{Binding BackCommand}" />
              <Button Classes="secondary safe" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- The file browser (to-do 122): Import Files and Add patch choose their file here (MainWindow.PickFileAsync). -->
    <Border x:Name="BrowserOverlay" Background="#B0000000"
            IsVisible="{Binding Browser, Converter={x:Static ObjectConverters.IsNotNull}}">
      <v:FileBrowserView x:Name="BrowserView" DataContext="{Binding Browser}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- User files being moved, and a save slot found in both places (SPEC 9.3): one slot at a time. -->
    <Border x:Name="UserFilesOverlay" Background="#B0000000" DataContext="{Binding UserFiles}" x:DataType="vm:UserFilesViewModel"
            IsVisible="{Binding IsBusy}">
      <Panel>
        <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
                CornerRadius="10" Padding="28,24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding Conflict, Converter={x:Static ObjectConverters.IsNull}}">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="Moving user files" />
            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
        </Border>
        <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
                CornerRadius="10" Padding="28,24" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding Conflict, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="16" />
            <TextBlock Text="{Binding SaveLine}" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" IsVisible="{Binding !ConfirmDelete}">
              <Button Content="Backup and Transfer" Command="{Binding BackupAndTransferCommand}" ToolTip.Tip="{Binding TransferTip}" />
              <Button Content="Backup and Delete" Command="{Binding BackupAndDeleteCommand}" ToolTip.Tip="{Binding BackupTip}" />
              <Button Content="{Binding DeleteText}" Command="{Binding AskDeleteCommand}" />
            </StackPanel>
            <StackPanel Spacing="10" IsVisible="{Binding ConfirmDelete}">
              <TextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" Foreground="#FFE0A040" />
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="Delete" Command="{Binding DeleteCommand}" />
                <Button Classes="safe" Content="Cancel" Command="{Binding CancelDeleteCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- Controls tab: "Press a key" for a key row, as F3 asks. Every key is the answer (the
         window passes them here); a click or wheel turn here, not on a button, is that mouse input. -->
    <Border x:Name="CaptureLayer" Background="#B0000000" DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel"
            IsVisible="{Binding IsCapturing}" Focusable="True" FocusAdorner="{x:Null}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="Press a key or a mouse button for:" />
          <TextBlock Classes="section" Text="{Binding Capturing.Label, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DimTextBrush}"
                     Text="Clicking here (not on a button) sets that mouse button; Esc is a key like any other." />
          <TextBlock Text="{Binding CaptureMessage}" TextWrapping="Wrap" Foreground="#FFE0A040"
                     IsVisible="{Binding CaptureMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="No key" Command="{Binding NoKeyCommand}" Focusable="False" />
            <Button Content="Cancel" Command="{Binding CancelCaptureCommand}" Focusable="False" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Button hints while the pad is in use (to-do 121 1f): at the very bottom, over everything
         (a pop-up's dimming too); the DockPanel keeps room for them. -->
    <ItemsControl ItemsSource="{Binding Hints}" IsVisible="{Binding PadMode}"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="18" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PadHint">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ItemsControl ItemsSource="{Binding Glyphs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PadGlyph">
                  <Border Background="{Binding Fill}" Height="20" MinWidth="20" Padding="5,0"
                          CornerRadius="{Binding Corners}">
                    <Panel>
                      <TextBlock Text="{Binding Text}" Foreground="{Binding Ink}" FontSize="11" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Path Data="{Binding Shape}" Stroke="{Binding Ink}" Fill="{Binding ShapeFill}" StrokeThickness="1.6" IsVisible="{Binding HasShape}"
                            Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</Window>
