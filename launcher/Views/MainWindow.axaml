<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConkerLauncher.ViewModels"
        xmlns:v="using:ConkerLauncher.Views"
        xmlns:l="using:ConkerLauncher.Services"
        x:Class="ConkerLauncher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Conker: Live &amp; Recompiled"
        Icon="/Assets/launcher.ico"
        Width="760" Height="700" MinWidth="760" MinHeight="700"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        Background="#FF0A0E0A">
  <Window.Resources>
    <!-- A running import or download, and the last one's result; shown in the section it belongs to. -->
    <DataTemplate x:Key="JobProgress" x:DataType="vm:FilesViewModel">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding ProgressText}" Foreground="{StaticResource DimTextBrush}" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent}"
                       IsIndeterminate="{Binding ProgressIndeterminate}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{l:T 'Cancel'}" Command="{Binding CancelCommand}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="JobStatus" x:DataType="vm:FilesViewModel">
      <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                 Classes.error="{Binding StatusIsError}" Classes.ok="{Binding !StatusIsError}" />
    </DataTemplate>
  </Window.Resources>
  <!-- The rows of the Settings and Controls tabs (the F2 and F3 menus' entries). -->
  <Window.DataTemplates>
    <DataTemplate DataType="vm:SectionItem">
      <TextBlock Classes="section" Text="{Binding Label}" Margin="0,14,0,4" />
    </DataTemplate>
    <!-- A heading with a checkbox that sets a group of options (Extras' Unload Reloaded, user 2026-11-25). -->
    <DataTemplate DataType="vm:GroupItem">
      <Border Classes="row" Margin="0,10,0,0">
        <CheckBox IsChecked="{Binding IsOn}" IsEnabled="{Binding IsAvailable}" ToolTip.Tip="{Binding Tip}"
                  AutomationProperties.Name="{Binding Label}">
          <TextBlock Classes="section" Text="{Binding Label}" />
        </CheckBox>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:LineItem">
      <Border Height="1" Background="{StaticResource DimTextBrush}" Opacity="0.5" Margin="0,12,0,6" />
    </DataTemplate>
    <DataTemplate DataType="vm:NoteItem">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DimTextBrush}" Margin="0,2,0,4" />
    </DataTemplate>
    <!-- Quality presets (to-do 202): a drop-down at the top of Graphics, as in F2. -->
    <DataTemplate DataType="vm:PresetItem">
      <Border Classes="row">
      <StackPanel Spacing="4" Margin="0,4" ToolTip.Tip="{Binding Tip}" Background="Transparent">
        <TextBlock Text="{Binding Label}" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Label}"
                  HorizontalAlignment="Stretch">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:PresetOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:CheckItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" IsEnabled="{Binding IsAvailable}"
                  ToolTip.Tip="{Binding Tip}" Margin="{Binding Indent}" />
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:ChoiceItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
      <StackPanel Spacing="4" Margin="0,4" ToolTip.Tip="{Binding Tip}" Background="Transparent">
        <TextBlock Text="{Binding Label}" />
        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" AutomationProperties.Name="{Binding Label}"
                  HorizontalAlignment="Stretch" IsEnabled="{Binding IsAvailable}">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChoiceOption">
              <TextBlock Text="{Binding Name}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
      </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:SliderItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
      <StackPanel Spacing="0" Margin="{Binding SliderIndent}" ToolTip.Tip="{Binding Tip}" Background="Transparent"
                  Grid.IsSharedSizeScope="True">
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
          <!-- A sound channel's Mute (to-do 13; user 2026-11-07): the word over the value, the box over the reset button. -->
          <TextBlock Grid.Column="1" Text="{l:T 'Mute'}" IsVisible="{Binding HasMute}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <CheckBox Classes="box" Grid.Column="2" IsChecked="{Binding IsMuted}" IsVisible="{Binding HasMute}" HorizontalAlignment="Center"
                    AutomationProperties.Name="{Binding MuteName}" MinWidth="0" MinHeight="0" Padding="0" />
        </Grid>
        <Grid ColumnSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="64" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="Reset" />
          </Grid.ColumnDefinitions>
          <Slider AutomationProperties.Name="{Binding Label}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Value}"
                  TickFrequency="{Binding Step}" IsSnapToTickEnabled="True"
                  SmallChange="{Binding Step}" IsEnabled="{Binding IsAvailable}" />
          <TextBlock Grid.Column="1" Text="{Binding ValueText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
          <Button Grid.Column="2" Content="↺" Command="{Binding ResetValueCommand}" ToolTip.Tip="{Binding ResetTip}"
                  AutomationProperties.Name="{Binding ResetTip}"
                  VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:RadioItem">
      <Border Classes="row">
      <ItemsControl ItemsSource="{Binding Options}" Margin="0,2">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RadioOption">
            <RadioButton Content="{Binding Name}" GroupName="{Binding Group}" IsChecked="{Binding IsChecked}" Margin="0,1" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </Border>
    </DataTemplate>
    <!-- A key row: the action (and the controller button it presses), its key, a reset icon when changed. -->
    <DataTemplate DataType="vm:KeyItem">
      <Border Classes="row" IsVisible="{Binding IsShown}">
      <Grid ColumnDefinitions="*,160,36,Auto,Auto" ColumnSpacing="6" Margin="0,1">
        <WrapPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,6,0" />
          <TextBlock Text="{Binding ButtonText}" Foreground="{StaticResource DimTextBrush}"
                     IsVisible="{Binding ButtonText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </WrapPanel>
        <Button Grid.Column="1" Content="{Binding KeyLabel}" Command="{Binding CaptureCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding AutomationName}"
                Classes.clash="{Binding IsClash}" ToolTip.Tip="{Binding ClashTip}" />
        <Button Grid.Column="2" Content="↺" Command="{Binding ResetKeyCommand}" IsVisible="{Binding IsChanged}"
                ToolTip.Tip="{Binding ResetTip}" AutomationProperties.Name="{Binding ResetTip}" VerticalAlignment="Center" />
        <!-- Single player's Controller column (to-do 39): the action's button for the scheme shown,
             or the controller's own fixed one, greyed. -->
        <Button Grid.Column="3" Width="160" Content="{Binding PadLabel}" Command="{Binding CapturePadCommand}"
                IsVisible="{Binding HasPad}" HorizontalContentAlignment="Center"
                AutomationProperties.Name="{Binding PadName}"
                ToolTip.Tip="{l:T 'Click, then press a button on a controller (or pick one)'}" />
        <TextBlock Grid.Column="3" Width="160" Text="{Binding PadFixed}" IsVisible="{Binding ShowPadFixed}"
                   Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                   ToolTip.Tip="{l:T 'The controller\'s own: not rebindable'}" />
        <Panel Grid.Column="4" Width="36" IsVisible="{Binding ShowPad}">
          <Button Content="↺" Command="{Binding ResetPadCommand}" IsVisible="{Binding PadChanged}"
                  ToolTip.Tip="{Binding PadResetTip}" AutomationProperties.Name="{Binding PadResetTip}" VerticalAlignment="Center" />
        </Panel>
      </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:KeyHeaderItem">
      <Border Classes="row">
      <Grid ColumnDefinitions="*,160,36,Auto,Auto" ColumnSpacing="6" Margin="0,4,0,0">
        <TextBlock Text="{l:T 'Action'}" Foreground="{StaticResource DimTextBrush}" />
        <TextBlock Grid.Column="1" Text="{l:T 'Keys'}" HorizontalAlignment="Center" Foreground="{StaticResource DimTextBrush}" />
        <TextBlock Grid.Column="3" Width="160" Text="{l:T 'Controller'}" TextAlignment="Center" Foreground="{StaticResource DimTextBrush}" />
        <Panel Grid.Column="4" Width="36" />
      </Grid>
      </Border>
    </DataTemplate>
    <DataTemplate DataType="vm:ResetPadItem">
      <StackPanel Margin="0,4,0,4" Spacing="6">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="#FFE0A040"
                   IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <Button Content="{Binding Label}" Command="{Binding AskCommand}" IsVisible="{Binding !IsAsking}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAsking}">
          <TextBlock Text="{Binding Question}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          <Button Content="{l:T 'Yes'}" Command="{Binding ConfirmCommand}" />
          <Button Classes="safe" Content="{l:T 'No'}" Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:FixedItem">
      <Grid ColumnDefinitions="200,*" ColumnSpacing="8" Margin="0,2">
        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding Keys}" TextWrapping="Wrap" />
      </Grid>
    </DataTemplate>
    <DataTemplate DataType="vm:ResetItem">
      <StackPanel Margin="0,10,0,4" Spacing="6">
        <Button Content="{Binding Label}" Command="{Binding AskCommand}" IsVisible="{Binding !IsAsking}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAsking}">
          <TextBlock Text="{Binding Question}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" />
          <Button Content="{l:T 'Yes'}" Command="{Binding ConfirmCommand}" />
          <Button Classes="safe" Content="{l:T 'No'}" Command="{Binding CancelCommand}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:SlotsItem">
      <StackPanel Spacing="4" Margin="0,6">
        <Grid ColumnDefinitions="70,*,90,90" ColumnSpacing="8">
          <TextBlock Text="{l:T 'Slot'}" Foreground="{StaticResource DimTextBrush}" />
          <TextBlock Grid.Column="1" Text="{l:T 'Controller'}" Foreground="{StaticResource DimTextBrush}" />
          <TextBlock Grid.Column="2" Text="{l:T 'Keyboard'}" Foreground="{StaticResource DimTextBrush}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SlotRow">
              <Border Classes="row">
              <Grid ColumnDefinitions="70,*,90,90" ColumnSpacing="8" Margin="0,2">
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                          AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoiceOption">
                      <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox Classes="box" Grid.Column="2" IsChecked="{Binding KeyboardOn}" ToolTip.Tip="{Binding KeyboardTip}"
                          AutomationProperties.Name="{Binding KeyboardName}" HorizontalAlignment="Center" />
                <!-- F3's per-slot Options window (rumble, sticks, gyro; user 2026-11-15). -->
                <Button Grid.Column="3" Content="{l:T 'Options'}" Command="{Binding OpenOptionsCommand}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding OptionsName}"
                        ToolTip.Tip="{l:T 'Rumble, sticks and gyro aiming for this slot\'s controller'}" />
              </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="{l:T 'Look for controllers again'}" Margin="0,4,0,0"
                Command="{Binding $parent[TabControl].((vm:ControlsViewModel)DataContext).RefreshPadsCommand}" />
      </StackPanel>
    </DataTemplate>
    <!-- F3 Slots' Chords button (to-do 39): one for every controller. -->
    <DataTemplate DataType="vm:ChordsItem">
      <Button Content="{l:T 'Chords'}" Command="{Binding OpenCommand}" Margin="0,6" AutomationProperties.Name="{l:T 'Chords'}"
              ToolTip.Tip="{l:T 'Two buttons held together for the menus, photo mode and cheats (every controller)'}" />
    </DataTemplate>
  </Window.DataTemplates>
  <Panel>
    <!-- A soft green glow behind the logo, like the original Xbox dashboard. -->
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="80%" RadiusY="60%">
          <GradientStop Color="#55107C10" Offset="0" />
          <GradientStop Color="#00107C10" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>

    <!-- The page (Page): while a pop-up shows, keyboard Tab skips it (MainWindow.UpdateOverlayFocus). -->
    <DockPanel x:Name="Page" Margin="24,0,24,20">
      <!-- The logo; dragging it moves the window, like a title bar. -->
      <Border DockPanel.Dock="Top" Background="Transparent" Padding="0,16,0,8"
              WindowDecorationProperties.ElementRole="TitleBar">
        <Image Source="/Assets/logo.png" Height="150" HorizontalAlignment="Center" />
      </Border>

      <!-- Room for the button hints (drawn last, over the pop-ups' dimming) while the pad is in use. -->
      <Border DockPanel.Dock="Bottom" Height="26" IsVisible="{Binding PadMode}" />

      <!-- Version History, Auto Update, Update and Play (SPEC 9.3) -->
      <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,16,0,0">
        <StackPanel VerticalAlignment="Center" Spacing="4">
          <TextBlock Text="{Binding Message}" Foreground="#FFE0A040" TextWrapping="Wrap"
                     IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding VersionLine}" Foreground="{StaticResource DimTextBrush}" FontSize="12" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Button Content="{l:T 'Version History'}" Command="{Binding OpenHistoryCommand}" FontSize="12" Padding="10,3" />
            <CheckBox Content="{l:T 'Auto Update'}" IsChecked="{Binding AutoUpdate}" FontSize="12" MinHeight="24"
                      ToolTip.Tip="{l:T 'Install a new version by itself whenever the launcher starts'}" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Classes="secondary" Content="{Binding UpdateButtonText}" Command="{Binding OpenUpdatePromptCommand}" />
        <Button Grid.Column="2" Classes="play" Content="{l:T 'PLAY'}" Command="{Binding PlayCommand}" />
      </Grid>

      <!-- Help line while the pad is in use (to-do 121 1f): the focused control's tooltip, which a
           pad can't hover; up to four lines (about 3 in 4 texts whole; user 2026-11-07), kept
           free so the page doesn't jump. -->
      <TextBlock DockPanel.Dock="Bottom" Text="{Binding HelpText}" IsVisible="{Binding PadMode}"
                 FontSize="12" Foreground="{StaticResource DimTextBrush}" TextWrapping="Wrap"
                 MaxLines="4" TextTrimming="CharacterEllipsis" Height="66" Margin="8,8,8,0" />

      <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
              BorderThickness="1" CornerRadius="8" Padding="12,4,12,12">
        <TabControl x:Name="MainTabs">
          <TabItem Header="{l:T 'FILES'}">
            <ScrollViewer DataContext="{Binding Files}" x:DataType="vm:FilesViewModel">
              <StackPanel Spacing="10" Margin="4,8,16,4">
                <!-- Game files -->
                <TextBlock Classes="section" Text="{l:T 'Game files'}" />
                <TextBlock Text="{Binding GameFilesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding ImportButtonText}" Command="{Binding ImportGameCommand}" />
                  <!-- An installed Xbox Store version found on this PC (to-do 37): imported in one click. -->
                  <Button Content="{l:T 'Import Xbox Store version'}" Command="{Binding ImportStoreVersionCommand}"
                          IsVisible="{Binding StoreVersionFound}" />
                </StackPanel>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobProgress}" IsVisible="{Binding GameJobVisible}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobStatus}" IsVisible="{Binding GameStatusVisible}" />

                <!-- Decensor patch -->
                <TextBlock Classes="section" Text="{l:T 'Decensor patch'}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding DecensorText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding AddPatchButtonText}" Command="{Binding AddPatchCommand}" />
                  <Button Content="{Binding DownloadButtonText}" Command="{Binding DownloadPatchCommand}" />
                </StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobProgress}" IsVisible="{Binding DecensorJobVisible}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobStatus}" IsVisible="{Binding DecensorStatusVisible}" />
                <TextBlock Text="{Binding DecensorCheckNote}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                           IsVisible="{Binding DecensorCheckNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                           Text="{l:T 'The decensor patch is made by nastys, Vaani and Theconker64 and is downloaded from their GitHub releases. It is not part of this launcher.'}" />

                <!-- Shaders: conker.exe precompile-shaders fills the shader cache (to-do 25, SPEC 9.3). -->
                <TextBlock Classes="section" Text="{l:T 'Shaders'}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding ShadersText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ConfirmDeleteShaders}">
                  <Button Content="{Binding PrecompileButtonText}" Command="{Binding PrecompileShadersCommand}" />
                  <Button Content="{l:T 'Delete Shaders'}" Command="{Binding AskDeleteShadersCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmDeleteShaders}">
                  <TextBlock Text="{l:T 'Delete every compiled shader? The game compiles them again as you play (or precompile again).'}"
                             TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="480" />
                  <Button Content="{l:T 'Yes'}" Command="{Binding DeleteShadersCommand}" />
                  <Button Classes="safe" Content="{l:T 'No'}" Command="{Binding CancelDeleteShadersCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding PrecompileError}" TextWrapping="Wrap" Classes="error"
                           IsVisible="{Binding PrecompileError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Game assets: conker.exe carve makes them from the game files (to-do 43, SPEC 9.3). -->
                <TextBlock Classes="section" Text="{l:T 'Game assets'}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding AssetsText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ConfirmDeleteAssets}">
                  <Button Content="{l:T 'Delete Assets'}" Command="{Binding AskDeleteAssetsCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmDeleteAssets}">
                  <TextBlock Text="{l:T 'Delete the prepared game assets? The launcher prepares them again the next time it starts.'}"
                             TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="480" />
                  <Button Content="{l:T 'Yes'}" Command="{Binding DeleteAssetsCommand}" />
                  <Button Classes="safe" Content="{l:T 'No'}" Command="{Binding CancelDeleteAssetsCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding AssetsError}" TextWrapping="Wrap" Classes="error"
                           IsVisible="{Binding AssetsError, Converter={x:Static ObjectConverters.IsNotNull}}" />

                <!-- Texture packs: conker.exe texture-export saves the textures as PNGs (to-do 238, SPEC 9.3). -->
                <TextBlock Classes="section" Text="{l:T 'Texture packs'}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding TexturesText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{Binding ExportButtonText}" Command="{Binding ExportTexturesCommand}"
                          ToolTip.Tip="{l:T 'Saves the textures of your game files as PNGs to make a texture pack from'}" />
                  <Button Content="{l:T 'Dump Folder'}" Command="{Binding OpenExportedTexturesCommand}"
                          ToolTip.Tip="{l:T 'Opens textures\\dump, where Export Textures saves the PNGs'}" />
                  <Button Content="{l:T 'Packs Folder'}" Command="{Binding OpenPacksFolderCommand}"
                          ToolTip.Tip="{l:T 'Opens textures\\packs, where each texture pack is a folder of its own'}" />
                </StackPanel>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobProgress}" IsVisible="{Binding TexturesJobVisible}" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JobStatus}" IsVisible="{Binding TexturesStatusVisible}" />
                <!-- The pack list (to-do 288 part 2d): settings.ini's [texture_packs], the same list as the game's
                     F2 > Extras > Texture Packs. A row's check box ticks; dragging a row (MainWindow.OnPackPointer*)
                     or holding A on it and pressing up / down (PadNavigator) moves it. -->
                <StackPanel Spacing="2" DataContext="{Binding Packs}" x:DataType="vm:TexturePacksViewModel" Margin="0,4,0,0">
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                             Margin="0,0,0,4" />
                  <ItemsControl x:Name="PackList" ItemsSource="{Binding Packs}" IsEnabled="{Binding CanChange}"
                                IsVisible="{Binding HasPacks}" Width="420" HorizontalAlignment="Left">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:TexturePackItem">
                        <Border Classes="packrow" Classes.held="{Binding IsHeld}">
                          <DockPanel>
                            <!-- The grip: drag here or anywhere on the row. -->
                            <Border DockPanel.Dock="Right" Background="Transparent" Cursor="SizeNorthSouth" Padding="12,6,4,6">
                              <Path Data="M0,0 H14 M0,5 H14 M0,10 H14" Stroke="{StaticResource DimTextBrush}"
                                    StrokeThickness="1.5" VerticalAlignment="Center" />
                            </Border>
                            <CheckBox Classes="pack" Content="{Binding Name}" IsChecked="{Binding On}"
                                      ToolTip.Tip="{l:T 'Ticked: the game uses this pack. Drag a pack to move it; with a controller, hold A on it and press up or down'}" />
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap"
                             IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <!-- User files: where they are kept (SPEC 9.3); a change moves them. -->
                <TextBlock Classes="section" Text="{l:T 'User files'}" Margin="0,8,0,0" />
                <StackPanel Spacing="4" DataContext="{Binding UserFiles}" x:DataType="vm:UserFilesViewModel">
                  <TextBlock Text="{l:T 'Saves, settings, photos and logs are kept in:'}" TextWrapping="Wrap" />
                  <RadioButton GroupName="UserFiles" Content="{l:T 'The game folder (userdata)'}" IsChecked="{Binding InGameFolder}"
                               IsEnabled="{Binding CanChoose}" />
                  <RadioButton GroupName="UserFiles" Content="{Binding AppDataText}" IsChecked="{Binding InAppData}"
                               IsEnabled="{Binding CanChoose}" />
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                             IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                             Classes.error="{Binding StatusIsError}" Classes.ok="{Binding !StatusIsError}"
                             IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="{l:T 'Logs'}" Command="{Binding OpenLogsCommand}" />
                  <Button Content="{l:T 'Saves'}" Command="{Binding OpenSavesCommand}" />
                  <Button Content="{l:T 'Photos'}" Command="{Binding OpenPhotosCommand}" />
                  <!-- The button's words follow the language; the Report Bug pop-up stays English, as the game's does (to-do 289). -->
                  <Button Content="{l:T 'Report Bug'}" Command="{Binding Report.OpenCommand}"
                          ToolTip.Tip="{l:T 'Makes a .zip to attach to a GitHub issue, for a crash noticed later'}" />
                </StackPanel>

                <!-- Steam (to-do 285): Add to Steam on real Windows; under Wine the release's add-to-steam.sh does it. -->
                <StackPanel Spacing="10" DataContext="{Binding Steam}" x:DataType="vm:SteamViewModel" IsVisible="{Binding Available}">
                  <TextBlock Classes="section" Text="Steam" Margin="0,8,0,0" />
                  <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsAsking}">
                    <Button Content="{l:T 'Add to Steam'}" Command="{Binding AskAddCommand}"
                            ToolTip.Tip="{l:T 'Adds the launcher to your Steam library with its artwork; Steam closes for a moment and starts again'}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAsking}">
                    <TextBlock Text="{l:T 'Steam is open: it closes while the game is added, then starts again. Go ahead?'}"
                               TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="480" />
                    <Button Content="{l:T 'Yes'}" Command="{Binding AddCommand}" />
                    <Button Classes="safe" Content="{l:T 'No'}" Command="{Binding CancelAddCommand}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                             Classes.error="{Binding StatusIsError}" Classes.ok="{Binding !StatusIsError}"
                             IsVisible="{Binding Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                             Text="{l:T 'The artwork is made by PopASquatt, Jiquita and EVE Online and is downloaded from SteamGridDB when you click. It is not part of this launcher.'}" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="{l:T 'SETTINGS'}">
            <!-- The game's F2 menu, from what conker.exe dump-settings prints (SPEC 9.3). -->
            <DockPanel DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="4,8,16,4">
                <TextBlock Text="{l:T 'The game is running: change settings in its F2 menu. This tab unlocks when the game closes.'}"
                           TextWrapping="Wrap" Foreground="#FFE0A040" IsVisible="{Binding IsLocked}" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Classes="error"
                           IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ConfirmReset}">
                  <Button Content="{l:T 'Reset to defaults'}" Command="{Binding AskResetCommand}" IsEnabled="{Binding IsEditable}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmReset}">
                  <TextBlock Text="{l:T 'Set every setting (all four tabs, not the controls) back to the default?'}"
                             TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="440" />
                  <Button Content="{l:T 'Reset'}" Command="{Binding ResetCommand}" />
                  <Button Classes="safe" Content="{l:T 'Cancel'}" Command="{Binding CancelResetCommand}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding TopItems}" IsEnabled="{Binding IsEditable}" />
              </StackPanel>
              <!-- F2's tabs (to-do 11). -->
              <TabControl Classes="inner" ItemsSource="{Binding Tabs}" IsEnabled="{Binding IsEditable}">
                <TabControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <ScrollViewer Offset="{Binding ScrollOffset, Mode=OneWay}">
                      <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,16,4" />
                    </ScrollViewer>
                  </DataTemplate>
                </TabControl.ContentTemplate>
              </TabControl>
            </DockPanel>
          </TabItem>
          <TabItem Header="{l:T 'CONTROLS'}">
            <!-- The game's F3 menu, from what conker.exe dump-settings and list-pads print (SPEC 9.3). -->
            <DockPanel DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel">
              <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="4,8,16,0">
                <TextBlock Text="{l:T 'The game is running: change controls in its F3 menu. This tab unlocks when the game closes.'}"
                           TextWrapping="Wrap" Foreground="#FFE0A040" IsVisible="{Binding IsLocked}" />
                <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Classes="error"
                           IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ItemsControl ItemsSource="{Binding TopItems}" IsEnabled="{Binding IsEditable}" />
              </StackPanel>
              <TabControl Classes="inner" ItemsSource="{Binding Tabs}" IsEnabled="{Binding IsEditable}">
                <TabControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MenuTab">
                    <ScrollViewer Offset="{Binding ScrollOffset, Mode=OneWay}">
                      <ItemsControl ItemsSource="{Binding Items}" Margin="4,0,16,4" />
                    </ScrollViewer>
                  </DataTemplate>
                </TabControl.ContentTemplate>
              </TabControl>
            </DockPanel>
          </TabItem>
          <TabItem Header="DEBUG">
            <!-- To-do 144 (SPEC 9.3): Debug Mode for Play, and the save editor (to-do 147, conker.exe edit-save). -->
            <ScrollViewer DataContext="{Binding Debug}" x:DataType="vm:DebugViewModel">
              <StackPanel Spacing="10" Margin="4,8,16,4">
                <TextBlock Classes="section" Text="Debug mode" />
                <Border Classes="row">
                  <CheckBox Content="Debug Mode" IsChecked="{Binding DebugMode}"
                            ToolTip.Tip="Play starts the game with --debug: the console (~), the Debug menu (F8), debug choices in F2, the frame rate in the title bar. Remembered" />
                </Border>
                <TextBlock Text="Play starts the game with the console, the Debug menu and its tools. Remembered for the next start."
                           TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" FontSize="12" />

                <TextBlock Classes="section" Text="Edit Save" Margin="0,8,0,0" />
                <TextBlock Text="Moves a save to the start of a chapter's part, as the Chapters list starts it; loading it then starts there. A copy of the save goes to edit_save_backups in the save folder first."
                           TextWrapping="Wrap" />
                <Grid ColumnDefinitions="70,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                  <TextBlock Text="Game" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding Games}" SelectedItem="{Binding SelectedGame}"
                            AutomationProperties.Name="Game" HorizontalAlignment="Stretch" ToolTip.Tip="The save to change">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:GameChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="Chapter" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Chapters}" SelectedItem="{Binding SelectedChapter}"
                            AutomationProperties.Name="Chapter" HorizontalAlignment="Stretch" ToolTip.Tip="The chapter, as the Chapters list has them">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ChapterChoice">
                        <TextBlock Text="{Binding Name}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Grid.Row="2" Text="Part" VerticalAlignment="Center" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding SelectedChapter.Parts}" SelectedItem="{Binding SelectedPart}"
                            AutomationProperties.Name="Part" HorizontalAlignment="Stretch" ToolTip.Tip="Where the save starts">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:PartChoice">
                        <TextBlock Text="{Binding Label}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>
                <Button Content="Edit Save" Command="{Binding AskEditCommand}" IsVisible="{Binding !IsAsking}"
                        ToolTip.Tip="Asks first; not while the game runs" />
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsAsking}">
                  <TextBlock Text="{Binding Question}" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                  <Button Content="Yes" Command="{Binding ConfirmEditCommand}" />
                  <Button Classes="safe" Content="No" Command="{Binding CancelEditCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                           Classes.error="{Binding StatusIsError}" Classes.ok="{Binding !StatusIsError}"
                           IsVisible="{Binding StatusText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </DockPanel>

    <!-- First launch: offer the import (SPEC 9.3); it can be closed, Play stays off. -->
    <!-- Not over the user files pop-ups: those come first. -->
    <Panel IsVisible="{Binding !UserFiles.IsBusy}">
    <Border x:Name="WelcomeOverlay" Background="#B0000000" IsVisible="{Binding ShowImportPrompt}">
      <Border x:Name="WelcomeBox" Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Classes="section" Text="{l:T 'Welcome'}" FontSize="22" />
          <TextBlock TextWrapping="Wrap"
                     Text="{l:T 'To play, the launcher needs the game files from your own copy of Conker: Live &amp; Reloaded: a disc image (.iso, PAL or USA), an archive holding it (.zip, .7z, .rar), a copied game folder, or the Xbox Store version.'}" />
          <!-- An installed Xbox Store version found on this PC (to-do 37): one click imports it. -->
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding Files.StoreVersionFound}">
            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{StaticResource XboxGreenBrush}"
                       Text="{l:T 'Xbox Store version found on this PC.'}" />
            <Button Grid.Column="1" Classes="play" Content="{l:T 'Import Xbox Store version'}" FontSize="16"
                    Command="{Binding ImportStoreFromPromptCommand}" />
          </Grid>
          <!-- A file dropped here is imported at once (to-do 122); a drag it won't take says why while it hovers. -->
          <Panel>
            <TextBlock Text="{l:T 'or drag your disc image here'}" FontSize="13" Foreground="{StaticResource DimTextBrush}"
                       IsVisible="{Binding WelcomeDropProblem, Converter={x:Static ObjectConverters.IsNull}}" />
            <TextBlock Classes="error" Text="{Binding WelcomeDropProblem}" FontSize="13" TextWrapping="Wrap"
                       IsVisible="{Binding WelcomeDropProblem, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Panel>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Classes="secondary safe" Content="{l:T 'Not now'}" Command="{Binding DismissImportPromptCommand}" />
            <Button Classes="play" Content="{l:T 'Import Files'}" FontSize="16" Command="{Binding ImportFromPromptCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    </Panel>

    <!-- A new release (SPEC 9.3): its page text, Update Now / Update Later, Don't remind me. -->
    <Panel IsVisible="{Binding !UserFiles.IsBusy}">
    <Border x:Name="UpdateOverlay" Background="#B0000000" IsVisible="{Binding ShowUpdatePrompt}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{l:T 'Update available'}" FontSize="22" />
          <TextBlock Text="{Binding UpdateTitle}" Foreground="{StaticResource DimTextBrush}" />
          <Border Background="#FF0A0E0A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer MaxHeight="340">
              <v:ReleaseNotesView Markdown="{Binding NewRelease.Body, FallbackValue=''}" Margin="14,10,18,12" />
            </ScrollViewer>
          </Border>
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <CheckBox Content="{l:T 'Don\'t remind me'}" IsChecked="{Binding SkipThisRelease}" VerticalAlignment="Center"
                      ToolTip.Tip="{l:T 'No window at start for this version; it shows again when a newer one is out'}" />
            <Button Grid.Column="1" Classes="secondary safe" Content="{l:T 'Update Later'}" Command="{Binding UpdateLaterCommand}" />
            <Button Grid.Column="2" Classes="play" Content="{l:T 'Update Now'}" FontSize="16" Command="{Binding UpdateCommand}" />
          </Grid>
        </StackPanel>
      </Border>
    </Border>

    <!-- Version History: every release's page text, newest first. -->
    <Border x:Name="HistoryOverlay" Background="#B0000000" IsVisible="{Binding ShowHistory}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="640" Height="600" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="{l:T 'Version history'}" FontSize="22" Margin="0,0,0,12" />
          <Button DockPanel.Dock="Bottom" Classes="secondary safe" Content="{l:T 'Close'}" Command="{Binding CloseHistoryCommand}"
                  HorizontalAlignment="Right" Margin="0,12,0,0" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryNote}" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}"
                     IsVisible="{Binding HistoryNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <Border Background="#FF0A0E0A" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" CornerRadius="6"
                  IsVisible="{Binding History, Converter={x:Static ObjectConverters.IsNotNull}}">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding History}" Margin="14,4,18,12">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:HistoryEntry">
                    <StackPanel Spacing="4" Margin="0,10,0,8">
                      <WrapPanel>
                        <TextBlock Classes="section" Text="{Binding Title}" FontSize="18" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding DateLine}" Foreground="{StaticResource DimTextBrush}" VerticalAlignment="Center" />
                      </WrapPanel>
                      <v:ReleaseNotesView Markdown="{Binding Body}" />
                      <HyperlinkButton Content="{l:T 'Open on GitHub'}" NavigateUri="{Binding Page}" Padding="0,2"
                                       IsVisible="{Binding Page, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <Border Height="1" Background="{StaticResource PanelBorderBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Border>
    </Border>
    </Panel>

    <!-- Report Bug (to-do 12d, SPEC 9.2): the Files tab's button; the zip is conker.exe's own. -->
    <Border x:Name="ReportOverlay" Background="#B0000000" DataContext="{Binding Files.Report}" x:DataType="vm:ReportBugViewModel"
            IsVisible="{Binding IsOpen}">
      <Border x:Name="ReportPanel" Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              Focusable="True" FocusAdorner="{x:Null}">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="Report Bug" FontSize="22" />
          <StackPanel Spacing="10" IsVisible="{Binding IsEdit}">
            <TextBlock Text="What went wrong, and what were you doing? (optional)" TextWrapping="Wrap" />
            <TextBox x:Name="ReportText" Text="{Binding Description}" AcceptsReturn="True" TextWrapping="Wrap" Height="150" />
            <CheckBox Content="Include save files" IsChecked="{Binding IncludeSaves}" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                       Text="Makes a .zip to attach to a GitHub issue: the game's last logs, its settings, the saves when ticked and the PC's details (Windows, graphics card, processor). The Windows user name is left out." />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Classes="secondary safe" Content="Cancel" Command="{Binding CloseCommand}" />
              <Button x:Name="ReportCreate" Classes="play" Content="Create Report" FontSize="16" Command="{Binding CreateCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="10" IsVisible="{Binding IsWorking}">
            <TextBlock Text="Creating the report..." Foreground="{StaticResource DimTextBrush}" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
          <StackPanel Spacing="10" IsVisible="{Binding IsDone}">
            <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                       Text="Open GitHub Issue opens a new issue with its text filled in and copies that text too: if the page comes up empty, paste it there (Ctrl+V). Then drag the zip into the issue. Posting needs a free GitHub account." />
            <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource DimTextBrush}"
                       IsVisible="{Binding Note, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button Content="Open Folder" Command="{Binding OpenFolderCommand}" />
              <Button x:Name="ReportIssue" Content="Open GitHub Issue" Command="{Binding OpenIssueCommand}" />
              <Button Classes="secondary safe" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Spacing="10" IsVisible="{Binding IsFailed}">
            <TextBlock Classes="error" Text="{Binding ResultText}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
              <Button x:Name="ReportBack" Content="Back" Command="{Binding BackCommand}" />
              <Button Classes="secondary safe" Content="Close" Command="{Binding CloseCommand}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- The file browser (to-do 122): Import Files and Add patch choose their file here (MainWindow.PickFileAsync). -->
    <Border x:Name="BrowserOverlay" Background="#B0000000"
            IsVisible="{Binding Browser, Converter={x:Static ObjectConverters.IsNotNull}}">
      <v:FileBrowserView x:Name="BrowserView" DataContext="{Binding Browser}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <!-- User files being moved, and a save slot found in both places (SPEC 9.3): one slot at a time. -->
    <Border x:Name="UserFilesOverlay" Background="#B0000000" DataContext="{Binding UserFiles}" x:DataType="vm:UserFilesViewModel"
            IsVisible="{Binding IsBusy}">
      <Panel>
        <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
                CornerRadius="10" Padding="28,24" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding Conflict, Converter={x:Static ObjectConverters.IsNull}}">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{l:T 'Moving user files'}" />
            <TextBlock Text="{Binding ProgressText}" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" />
            <ProgressBar IsIndeterminate="True" />
          </StackPanel>
        </Border>
        <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
                CornerRadius="10" Padding="28,24" Width="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                IsVisible="{Binding Conflict, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="14">
            <TextBlock Text="{Binding Question}" TextWrapping="Wrap" FontSize="16" />
            <TextBlock Text="{Binding SaveLine}" TextWrapping="Wrap" Foreground="{StaticResource DimTextBrush}" />
            <!-- 640 wide and a wrapping row (to-do 289): French / Spanish / Italian button names are longer;
                 a language still too long puts the last button on a second line instead of cutting it off. -->
            <WrapPanel ItemSpacing="10" LineSpacing="8" HorizontalAlignment="Right" IsVisible="{Binding !ConfirmDelete}">
              <Button Content="{l:T 'Backup and Transfer'}" Command="{Binding BackupAndTransferCommand}" ToolTip.Tip="{Binding TransferTip}" />
              <Button Content="{l:T 'Backup and Delete'}" Command="{Binding BackupAndDeleteCommand}" ToolTip.Tip="{Binding BackupTip}" />
              <Button Content="{Binding DeleteText}" Command="{Binding AskDeleteCommand}" />
            </WrapPanel>
            <StackPanel Spacing="10" IsVisible="{Binding ConfirmDelete}">
              <TextBlock Text="{Binding DeleteQuestion}" TextWrapping="Wrap" Foreground="#FFE0A040" />
              <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <Button Content="{l:T 'Delete'}" Command="{Binding DeleteCommand}" />
                <Button Classes="safe" Content="{l:T 'Cancel'}" Command="{Binding CancelDeleteCommand}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>
    </Border>

    <!-- Controls tab, Slots: a slot's Options (F3's per-slot window: rumble, sticks, gyro;
         user 2026-11-15). The rows are the same items F3 describes, drawn by the templates above. -->
    <Border x:Name="SlotOptionsOverlay" Background="#B0000000" DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel"
            IsVisible="{Binding OptionsRow, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="{Binding OptionsRow.OptionsTitle, FallbackValue=''}" FontSize="22" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding OptionsRow.ControllerText, FallbackValue=''}" Foreground="{StaticResource DimTextBrush}"
                     TextWrapping="Wrap" Margin="0,2,0,8" />
          <Button DockPanel.Dock="Bottom" Classes="secondary safe" Content="{l:T 'Close'}" Command="{Binding CloseOptionsCommand}"
                  AutomationProperties.Name="{l:T 'Close slot options'}" HorizontalAlignment="Right" Margin="0,12,0,0" />
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding OptionsRow.Items, FallbackValue={x:Null}}" Margin="0,0,14,0" />
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- Controls tab, Slots: Chords (F3's chords_window; to-do 39, the user's plan 2026-11-17): every
         function a chord drives, by group, its chord from a list or pressed on a controller. -->
    <Border x:Name="ChordsOverlay" Background="#B0000000" DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel"
            IsVisible="{Binding ChordsOpen}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="680" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="section" Text="{l:T 'Controller chords'}" FontSize="22" />
          <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,2,0,8" FontSize="13" Foreground="{StaticResource DimTextBrush}"
                     Text="{l:T 'Two buttons held together for our own extras, on slot 1\'s controller; one set for every controller, apart from its normal controls. Button names are an Xbox controller\'s: on a PlayStation controller Back = Share / Create, Start = Options, LB / RB = L1 / R1, A / B / X / Y = Cross / Circle / Square / Triangle.'}" />
          <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="{Binding ChordsMessage}" TextWrapping="Wrap" Foreground="#FFE0A040"
                       IsVisible="{Binding ChordsMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding AskResetChords}">
              <TextBlock Text="{l:T 'Put every chord back to its default?'}" VerticalAlignment="Center" />
              <Button Content="{l:T 'Yes'}" Command="{Binding ConfirmResetChordsCommand}" />
              <Button Content="{l:T 'No'}" Command="{Binding CancelResetChordsCommand}" />
            </StackPanel>
            <DockPanel>
              <Button DockPanel.Dock="Left" Content="{l:T 'Reset all chords'}" Command="{Binding ResetChordsCommand}"
                      IsVisible="{Binding !AskResetChords}" />
              <Button Classes="secondary safe" Content="{l:T 'Close'}" Command="{Binding CloseChordsCommand}"
                      AutomationProperties.Name="{l:T 'Close chords'}" HorizontalAlignment="Right" />
            </DockPanel>
          </StackPanel>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding ChordGroups}" Margin="0,0,14,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChordGroupView">
                  <StackPanel Spacing="4" Margin="0,6,0,4">
                    <TextBlock Classes="section" Text="{Binding Name}" />
                    <TextBlock Text="{Binding Tip}" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DimTextBrush}" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChordRow">
                          <Border Classes="row">
                            <!-- 270: a French D-pad chord ("Croix directionnelle droite + Start") whole (to-do 289). -->
                            <Grid ColumnDefinitions="*,270,80,36" ColumnSpacing="8" Margin="0,2">
                              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding Tip}">
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{l:T '(required)'}" Foreground="{StaticResource DimTextBrush}" IsVisible="{Binding Required}" />
                              </StackPanel>
                              <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}"
                                        AutomationProperties.Name="{Binding Name}" HorizontalAlignment="Stretch" MaxDropDownHeight="420">
                                <ComboBox.Styles>
                                  <Style Selector="ComboBoxItem" x:DataType="vm:ChordOption">
                                    <Setter Property="IsEnabled" Value="{Binding IsFree}" />
                                  </Style>
                                </ComboBox.Styles>
                                <ComboBox.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ChordOption">
                                    <TextBlock Text="{Binding Display}" />
                                  </DataTemplate>
                                </ComboBox.ItemTemplate>
                              </ComboBox>
                              <Button Grid.Column="2" Content="{l:T 'Press'}" Command="{Binding PressCommand}" HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Center" AutomationProperties.Name="{Binding PressName}"
                                      ToolTip.Tip="{l:T 'Set it by holding the chord on a controller'}" />
                              <Button Grid.Column="3" Content="&#x21BA;" Command="{Binding ResetCommand}" IsVisible="{Binding !IsDefault}"
                                      AutomationProperties.Name="{Binding ResetName}" ToolTip.Tip="{Binding ResetTip}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- Chords: "Press the chord" for one function. The controller's buttons are its (PadNavigator
         hands them over); B alone or Esc cancels. -->
    <Border x:Name="ChordCaptureLayer" Background="#B0000000" DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel"
            IsVisible="{Binding IsChordCapturing}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="{l:T 'On a controller, hold two buttons together for:'}" />
          <TextBlock Classes="section" Text="{Binding ChordCapturing.Label, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ChordCapturing.ChordNowText, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DimTextBrush}"
                     Text="{l:T 'Hold one button and press the other: Back or RB with another button, a D-pad direction with A, B, X, Y, LB, Start, RB or Back, or both sticks clicked. B alone, Esc or Cancel: no change.'}" />
          <TextBlock Text="{Binding ChordCaptureMessage}" TextWrapping="Wrap" Foreground="#FFE0A040"
                     IsVisible="{Binding ChordCaptureMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{l:T 'No chord'}" Command="{Binding NoChordCommand}" Focusable="False"
                    IsVisible="{Binding !ChordCapturing.Required, FallbackValue=False}" />
            <Button Classes="safe" Content="{l:T 'Cancel'}" Command="{Binding CancelChordCaptureCommand}" Focusable="False" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Controls tab: "Press a button" for a single player row's controller button (to-do 39). The
         controller's buttons are its (PadNavigator hands them over); Back, Esc or Cancel: no change. -->
    <Border x:Name="PadCaptureLayer" Background="#B0000000" DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel"
            IsVisible="{Binding IsPadCapturing}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="{l:T 'On a controller, press the button for:'}" />
          <TextBlock Classes="section" Text="{Binding PadCaptureTitle}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding PadNowText}" TextWrapping="Wrap" />
          <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DimTextBrush}"
                     Text="{l:T 'A button another action uses at the same moment swaps with this one. Back, Esc or Cancel: no change. Back and the D-pad can\'t be bound. Button names are an Xbox controller\'s (PlayStation: A / B / X / Y = Cross / Circle / Square / Triangle, LB / RB / LT / RT = L1 / R1 / L2 / R2, Start = Options).'}" />
          <TextBlock Text="{Binding PadCaptureMessage}" TextWrapping="Wrap" Foreground="#FFE0A040"
                     IsVisible="{Binding PadCaptureMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <ComboBox ItemsSource="{Binding PadOptions}" SelectedItem="{Binding PadSelected}" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="{l:T 'Controller button'}" MaxDropDownHeight="420">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PadOption">
                <TextBlock Text="{Binding Display}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{l:T 'No button'}" Command="{Binding NoPadButtonCommand}" Focusable="False"
                    IsVisible="{Binding PadNoneAllowed}" />
            <Button Classes="safe" Content="{l:T 'Cancel'}" Command="{Binding CancelPadCaptureCommand}" Focusable="False" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Controls tab: "Press a key" for a key row, as F3 asks. Every key is the answer (the
         window passes them here); a click or wheel turn here, not on a button, is that mouse input. -->
    <Border x:Name="CaptureLayer" Background="#B0000000" DataContext="{Binding Controls}" x:DataType="vm:ControlsViewModel"
            IsVisible="{Binding IsCapturing}" Focusable="True" FocusAdorner="{x:Null}">
      <Border Background="#FF111811" BorderBrush="{StaticResource XboxGreenBrush}" BorderThickness="1"
              CornerRadius="10" Padding="28,24" Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="10">
          <TextBlock Text="{l:T 'Press a key or a mouse button for:'}" />
          <TextBlock Classes="section" Text="{Binding Capturing.Label, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Capturing.KeysNow, FallbackValue=''}" TextWrapping="Wrap" />
          <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DimTextBrush}"
                     Text="{l:T 'A key it doesn\'t have is added (up to 3), a key it has is taken off. For a combo hold one key and press another. Clicking here (not on a button) is that mouse button. Esc cancels.'}" />
          <TextBlock Text="{Binding HoldingText}" TextWrapping="Wrap"
                     IsVisible="{Binding HoldingText, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Text="{Binding CaptureMessage}" TextWrapping="Wrap" Foreground="#FFE0A040"
                     IsVisible="{Binding CaptureMessage, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{l:T 'No key'}" Command="{Binding NoKeyCommand}" Focusable="False" />
            <Button Content="{l:T 'Cancel'}" Command="{Binding CancelCaptureCommand}" Focusable="False" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Button hints while the pad is in use (to-do 121 1f): at the very bottom, over everything
         (a pop-up's dimming too); the DockPanel keeps room for them. -->
    <ItemsControl ItemsSource="{Binding Hints}" IsVisible="{Binding PadMode}"
                  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="18" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PadHint">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ItemsControl ItemsSource="{Binding Glyphs}" VerticalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PadGlyph">
                  <Border Background="{Binding Fill}" Height="20" MinWidth="20" Padding="5,0"
                          CornerRadius="{Binding Corners}">
                    <Panel>
                      <TextBlock Text="{Binding Text}" Foreground="{Binding Ink}" FontSize="11" FontWeight="Bold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                      <Path Data="{Binding Shape}" Stroke="{Binding Ink}" Fill="{Binding ShapeFill}" StrokeThickness="1.6" IsVisible="{Binding HasShape}"
                            Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center" />
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </Panel>
</Window>
